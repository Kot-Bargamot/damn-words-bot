# --- обязательные ---
TELEGRAM_BOT_TOKEN=123456:ABC...
GROQ_API_KEY=gsk_...
# Ваш Telegram user ID (узнать: @userinfobot). Сообщения остальных игнорируются.
ALLOWED_USER_ID=123456789
# Публичный репозиторий с грамматикой, owner/name
GITHUB_REPO=yourname/english-grammar

# --- прокси (опционально, для всего контейнера) ---
# Весь исходящий трафик: Telegram, Groq, GitHub. Схемы: http, https, socks5, socks5h.
# Пусто — без прокси. Вместо PROXY_URL можно задать HTTPS_PROXY/HTTP_PROXY/NO_PROXY напрямую.
PROXY_URL=
# PROXY_URL=socks5h://user:pass@proxy.example.com:1080
# NO_PROXY=localhost,127.0.0.1,::1

# --- GitHub ---
# Токен нужен для записи (fine-grained, только этот репозиторий, Contents: Read and write).
GITHUB_TOKEN=
GITHUB_BRANCH=main

# --- Groq ---
GROQ_MODEL=openai/gpt-oss-120b
# strict — строгое соответствие JSON-схеме (gpt-oss-20b/120b и др. по списку Groq);
# best_effort — схема без гарантии; json_object — для остальных моделей.
GROQ_RESPONSE_FORMAT=strict
# пусто — "low" для gpt-oss; none — не передавать параметр
GROQ_REASONING_EFFORT=
GROQ_TEMPERATURE=0.5
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_SEC=60
GROQ_RETRIES=2
GROQ_MIN_INTERVAL_MS=1000

# --- обучение ---
MAX_ITEMS_PER_MESSAGE=7
SESSION_TASKS=5
NEW_ITEMS_PER_SESSION=2
DIALOGUE_TURNS=4
SRS_LADDER_DAYS=1,3,7,14,30,60
TZ=Asia/Vladivostok
